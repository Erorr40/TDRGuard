#include <windows.h>

// Application Manifest - request asInvoker execution level
// UAC elevation is done programmatically when needed
1 RT_MANIFEST "TDRGuard.manifest"

// Version Information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Error40"
            VALUE "FileDescription",  "TDRGuard - GPU Watchdog & Crash Snapshotter"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "TDRGuard"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "TDRGuard.exe"
            VALUE "ProductName",      "TDRGuard"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
